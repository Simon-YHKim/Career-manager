# Career Manager — environment variables template
#
# Copy to `.env.local` (Web — Next.js auto-loads it) and `apps/android/local.properties`
# (Android — Gradle reads it). NEVER commit `.env.local` or `local.properties`.
#
# Sprint 1 (current) does NOT consume any of these at runtime. They're documented
# here so devs and CI know what S2+ will require.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (S2: Auth · DB · Storage)
# ─────────────────────────────────────────────────────────────────────────────
# Project URL — public, OK to ship to client
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon key — public, safe in client. Subject to RLS once policies land in S2.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_me

# Service role key — SERVER ONLY. Never expose to the browser. Bypasses RLS.
# Used by Next.js Route Handlers / Server Actions only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_me

# Project reference — used by `supabase` CLI for migration push
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Local DB password — only needed when running `supabase db push` against linked project
SUPABASE_DB_PASSWORD=replace_me

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
# Canonical site URL — used by `metadataBase`, sitemap, OG image base
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# OAuth providers (S2 — Google · Apple · Email Magic Link)
# ─────────────────────────────────────────────────────────────────────────────
# Configured in Supabase Dashboard → Authentication → Providers.
# Listed here as the secrets that need to be populated there:
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OAuth providers (S3 — Korean: Kakao · Naver · LinkedIn)
# ─────────────────────────────────────────────────────────────────────────────
# Naver does not have native Supabase support → custom OIDC route.
# Audit phase 2 flagged this as a 1-day spike before S3.
#
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Payments (S18 — PortOne; Iamport is deprecated as of 2026-03)
# ─────────────────────────────────────────────────────────────────────────────
# PORTONE_API_SECRET=
# PORTONE_CHANNEL_KEY=
# PORTONE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# LLM providers (S6+)
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Observability (S2+)
# ─────────────────────────────────────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
